"""Generated by gee-agent-skill: generic annual endpoint-transition workflow.

This script creates derived features and model outputs only. It does not make a
scientific claim that classifier ambiguity is a rural-urban transition zone.
"""

from __future__ import annotations

import ee


SCRIPT_NAME = {{ script_name | tojson }}
EXPECTED_YEARS = {{ years | tojson }}
START_DATE = f"{EXPECTED_YEARS[0]}-01-01"
END_DATE = f"{EXPECTED_YEARS[-1] + 1}-01-01"
DATASET_ID = "NASA/HLS/HLSL30/v002"
HLS_L30_DATASET_ID = DATASET_ID
HLS_S30_DATASET_ID = "NASA/HLS/HLSS30/v002"
COMMUNITY_ASSET_ID = "projects/sat-io/open-datasets/ORNL/LANDSCAN_GLOBAL"
COMMUNITY_ASSET_EXPECTED_BAND = "b1"
COMMUNITY_ASSET_EXPECTED_YEARS = EXPECTED_YEARS
ANNUAL_CATEGORICAL_ASSET_ID = {{ annual_landcover_asset | tojson }}
ACTIVITY_COLLECTION_ID = {{ activity_collection_id | tojson }}
ACTIVITY_BAND = {{ activity_band | tojson }}
ACCESSIBILITY_IMAGE_ID = {{ accessibility_image_id | tojson }}
AOI_ASSET = {{ aoi_asset | tojson }}
LANDCOVER_BAND = {{ landcover_band | tojson }}
IMPERVIOUS_CLASS_CODES = {{ impervious_class_codes | tojson }}
CROPLAND_CLASS_CODES = {{ cropland_class_codes | tojson }}
ECOLOGICAL_CLASS_CODES = {{ ecological_class_codes | tojson }}

CRS_INPUT = {{ target_crs | tojson }}
# Earth Engine does not currently parse the short EPSG:6933 identifier. Use
# the equivalent WKT1 definition while preserving EPSG:6933 in the plan and
# output metadata. Extend this reviewed mapping only after a live parse check.
GEE_CRS_OVERRIDES = {
    "EPSG:6933": 'PROJCS["WGS 84 / NSIDC EASE-Grid 2.0 Global",GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.0174532925199433,AUTHORITY["EPSG","9122"]],AUTHORITY["EPSG","4326"]],PROJECTION["Cylindrical_Equal_Area"],PARAMETER["standard_parallel_1",30],PARAMETER["central_meridian",0],PARAMETER["false_easting",0],PARAMETER["false_northing",0],UNIT["metre",1,AUTHORITY["EPSG","9001"]],AXIS["Easting",EAST],AXIS["Northing",NORTH],AUTHORITY["EPSG","6933"]]',
}
CRS = GEE_CRS_OVERRIDES.get(CRS_INPUT.upper(), CRS_INPUT)
CRS_TRANSFORM = {{ target_crs_transform | tojson }}
SCALE = abs(CRS_TRANSFORM[0])
GRID_ALIGNMENT_POLICY = "fixed_equal_area_crs_transform"
COUNT_AGGREGATION_POLICY = "count_to_density_then_area_weighted"
CATEGORICAL_AGGREGATION_POLICY = "per_class_area_fraction_no_bilinear"
COMMUNITY_ASSET_METADATA_POLICY = "verify_asset_band_years_and_system_time_start"
PRIVATE_ASSET_EXPORT_POLICY = "derived_outputs_only"
CROSS_VERSION_POLICY = "single_reviewed_activity_collection_for_all_expected_years"

STABLE_YEAR_MIN = {{ stable_year_min }}
URBAN_IMPERVIOUS_THRESHOLD = {{ urban_impervious_threshold }}
RURAL_CROPLAND_THRESHOLD = {{ rural_cropland_threshold }}
URBAN_ACTIVITY_THRESHOLD = {{ urban_activity_threshold }}
RURAL_ACTIVITY_THRESHOLD = {{ rural_activity_threshold }}
SAMPLES_PER_CLASS = {{ samples_per_class }}
TREES = {{ trees }}
MIN_LEAF_POPULATION = {{ min_leaf_population }}
RANDOM_SEED = {{ random_seed }}
DRIVE_FOLDER = {{ drive_folder | tojson }}
FILE_PREFIX = {{ file_prefix | tojson }}
EXPORT_DESCRIPTION = f"{FILE_PREFIX}_annual_transition"
MAX_PIXELS = {{ max_pixels }}

FEATURE_BANDS = [
    "blue_p50",
    "green_p50",
    "red_p50",
    "nir_p50",
    "swir1_p50",
    "swir2_p50",
    "ndvi_p50",
    "ndwi_p50",
    "ndbi_p50",
    "bsi_p50",
    "ndvi_p25",
    "ndvi_p75",
    "valid_observation_count",
    "population_count",
    "accessibility",
]


def _target_projection() -> ee.Projection:
    return ee.Projection(CRS, CRS_TRANSFORM)


def _target_grid(image: ee.Image) -> ee.Image:
    return image.setDefaultProjection(_target_projection()).reproject(
        crs=CRS,
        crsTransform=CRS_TRANSFORM,
    )


def _mask_hls(image: ee.Image) -> ee.Image:
    fmask = image.select("Fmask")
    clear = fmask.bitwiseAnd(31).eq(0)
    return image.updateMask(clear)


def _prepare_l30(image: ee.Image) -> ee.Image:
    optical = (
        _mask_hls(image)
        .select(["B2", "B3", "B4", "B5", "B6", "B7"], ["blue", "green", "red", "nir", "swir1", "swir2"])
        .multiply(0.0001)
    )
    return _add_indices(optical).copyProperties(image, ["system:time_start"])


def _prepare_s30(image: ee.Image) -> ee.Image:
    optical = (
        _mask_hls(image)
        .select(["B2", "B3", "B4", "B8A", "B11", "B12"], ["blue", "green", "red", "nir", "swir1", "swir2"])
        .multiply(0.0001)
    )
    return _add_indices(optical).copyProperties(image, ["system:time_start"])


def _add_indices(image: ee.Image) -> ee.Image:
    ndvi = image.normalizedDifference(["nir", "red"]).rename("ndvi")
    ndwi = image.normalizedDifference(["green", "nir"]).rename("ndwi")
    ndbi = image.normalizedDifference(["swir1", "nir"]).rename("ndbi")
    bsi = image.expression(
        "((swir1 + red) - (nir + blue)) / ((swir1 + red) + (nir + blue))",
        {
            "swir1": image.select("swir1"),
            "red": image.select("red"),
            "nir": image.select("nir"),
            "blue": image.select("blue"),
        },
    ).rename("bsi")
    return image.addBands([ndvi, ndwi, ndbi, bsi])


def _annual_hls(year: int, aoi: ee.Geometry) -> ee.Image:
    start = ee.Date.fromYMD(year, 1, 1)
    end = start.advance(1, "year")
    l30 = ee.ImageCollection(HLS_L30_DATASET_ID).filterDate(start, end).filterBounds(aoi).map(_prepare_l30)
    s30 = ee.ImageCollection(HLS_S30_DATASET_ID).filterDate(start, end).filterBounds(aoi).map(_prepare_s30)
    merged = l30.merge(s30)
    percentiles = merged.reduce(ee.Reducer.percentile([25, 50, 75]))
    selected = percentiles.select(
        [
            "blue_p50",
            "green_p50",
            "red_p50",
            "nir_p50",
            "swir1_p50",
            "swir2_p50",
            "ndvi_p50",
            "ndwi_p50",
            "ndbi_p50",
            "bsi_p50",
            "ndvi_p25",
            "ndvi_p75",
        ]
    )
    valid = merged.select("red").count().rename("valid_observation_count")
    return _target_grid(selected.addBands(valid)).set({"year": year, "system:time_start": start.millis()})


def _annual_population(year: int, aoi: ee.Geometry) -> ee.Image:
    start = ee.Date.fromYMD(year, 1, 1)
    source = (
        ee.ImageCollection(COMMUNITY_ASSET_ID)
        .filterDate(start, start.advance(1, "year"))
        .filterBounds(aoi)
        .select(COMMUNITY_ASSET_EXPECTED_BAND)
        .first()
    )
    population_count = ee.Image(source)
    population_density = population_count.divide(ee.Image.pixelArea())
    target_density = population_density.reduceResolution(reducer=ee.Reducer.mean(), maxPixels=4096).reproject(
        crs=CRS,
        crsTransform=CRS_TRANSFORM,
    )
    return target_density.multiply(ee.Image.pixelArea()).rename("population_count").set(
        {"year": year, "system:time_start": start.millis()}
    )


def _annual_activity(year: int, aoi: ee.Geometry) -> ee.Image:
    start = ee.Date.fromYMD(year, 1, 1)
    annual = (
        ee.ImageCollection(ACTIVITY_COLLECTION_ID)
        .filterDate(start, start.advance(1, "year"))
        .filterBounds(aoi)
        .select(ACTIVITY_BAND)
        .mean()
        .rename("activity")
    )
    return _target_grid(annual).set({"year": year, "system:time_start": start.millis()})


def _class_fraction(image: ee.Image, class_codes: list[int], name: str) -> ee.Image:
    masks = [image.eq(code) for code in class_codes]
    combined = ee.ImageCollection.fromImages(masks).max()
    fraction = combined.reduceResolution(reducer=ee.Reducer.mean(), maxPixels=4096).reproject(
        crs=CRS,
        crsTransform=CRS_TRANSFORM,
    )
    return fraction.rename(name)


def _annual_landcover(year: int, aoi: ee.Geometry) -> ee.Image:
    start = ee.Date.fromYMD(year, 1, 1)
    categorical = (
        ee.ImageCollection(ANNUAL_CATEGORICAL_ASSET_ID)
        .filterDate(start, start.advance(1, "year"))
        .filterBounds(aoi)
        .select(LANDCOVER_BAND)
        .first()
    )
    categorical = ee.Image(categorical)
    return (
        _class_fraction(categorical, IMPERVIOUS_CLASS_CODES, "impervious_fraction")
        .addBands(_class_fraction(categorical, CROPLAND_CLASS_CODES, "cropland_fraction"))
        .addBands(_class_fraction(categorical, ECOLOGICAL_CLASS_CODES, "ecological_fraction"))
        .set({"year": year, "system:time_start": start.millis()})
    )


def _accessibility() -> ee.Image:
    return _target_grid(ee.Image(ACCESSIBILITY_IMAGE_ID).select("accessibility").rename("accessibility"))


def _annual_feature_stack(year: int, aoi: ee.Geometry) -> ee.Image:
    return (
        _annual_hls(year, aoi)
        .addBands(_annual_population(year, aoi))
        .addBands(_accessibility())
        .set({"year": year, "system:time_start": ee.Date.fromYMD(year, 1, 1).millis()})
    )


def _coverage_manifest(aoi: ee.Geometry) -> ee.FeatureCollection:
    def one_year(year: int) -> ee.Feature:
        start = ee.Date.fromYMD(year, 1, 1)
        end = start.advance(1, "year")
        return ee.Feature(
            None,
            {
                "year": year,
                "hls_l30_count": ee.ImageCollection(HLS_L30_DATASET_ID).filterDate(start, end).filterBounds(aoi).size(),
                "hls_s30_count": ee.ImageCollection(HLS_S30_DATASET_ID).filterDate(start, end).filterBounds(aoi).size(),
                "landscan_count": ee.ImageCollection(COMMUNITY_ASSET_ID).filterDate(start, end).filterBounds(aoi).size(),
                "landcover_count": ee.ImageCollection(ANNUAL_CATEGORICAL_ASSET_ID).filterDate(start, end).filterBounds(aoi).size(),
                "activity_count": ee.ImageCollection(ACTIVITY_COLLECTION_ID).filterDate(start, end).filterBounds(aoi).size(),
            },
        )

    return ee.FeatureCollection([one_year(year) for year in EXPECTED_YEARS])


def _stable_endpoint_masks(aoi: ee.Geometry) -> tuple[ee.Image, ee.Image]:
    urban_votes = []
    rural_votes = []
    for year in EXPECTED_YEARS:
        landcover = _annual_landcover(year, aoi)
        activity = _annual_activity(year, aoi)
        urban_votes.append(
            landcover.select("impervious_fraction").gte(URBAN_IMPERVIOUS_THRESHOLD)
            .And(activity.select("activity").gte(URBAN_ACTIVITY_THRESHOLD))
        )
        rural_votes.append(
            landcover.select("cropland_fraction").gte(RURAL_CROPLAND_THRESHOLD)
            .And(activity.select("activity").lte(RURAL_ACTIVITY_THRESHOLD))
        )
    stable_urban = ee.ImageCollection.fromImages(urban_votes).sum().gte(STABLE_YEAR_MIN)
    stable_rural = ee.ImageCollection.fromImages(rural_votes).sum().gte(STABLE_YEAR_MIN)
    return stable_urban, stable_rural


def _endpoint_samples(aoi: ee.Geometry) -> ee.FeatureCollection:
    stable_urban, stable_rural = _stable_endpoint_masks(aoi)
    endpoint_label = ee.Image(0).where(stable_urban, 1).rename("endpoint_label").updateMask(stable_urban.Or(stable_rural))
    yearly_samples = []
    for year in EXPECTED_YEARS:
        features = _annual_feature_stack(year, aoi).select(FEATURE_BANDS)
        samples = features.addBands(endpoint_label).stratifiedSample(
            numPoints=SAMPLES_PER_CLASS,
            classBand="endpoint_label",
            region=aoi,
            scale=SCALE,
            projection=_target_projection(),
            seed=RANDOM_SEED + year,
            geometries=False,
            tileScale=4,
        )
        yearly_samples.append(samples.map(lambda feature: feature.set("year", year)))
    return ee.FeatureCollection(yearly_samples).flatten()


def _train_classifier(samples: ee.FeatureCollection) -> ee.Classifier:
    return (
        ee.Classifier.smileRandomForest(
            numberOfTrees=TREES,
            minLeafPopulation=MIN_LEAF_POPULATION,
            seed=RANDOM_SEED,
        )
        .setOutputMode("PROBABILITY")
        .train(features=samples, classProperty="endpoint_label", inputProperties=FEATURE_BANDS)
    )


def build_export_tasks() -> list[ee.batch.Task]:
    aoi = ee.FeatureCollection(AOI_ASSET).geometry()
    coverage = _coverage_manifest(aoi)
    samples = _endpoint_samples(aoi)
    classifier = _train_classifier(samples)
    tasks: list[ee.batch.Task] = [
        ee.batch.Export.table.toDrive(
            collection=coverage,
            description=f"{EXPORT_DESCRIPTION}_coverage",
            folder=DRIVE_FOLDER,
            fileNamePrefix=f"{FILE_PREFIX}_coverage",
            fileFormat="CSV",
            selectors=["year", "hls_l30_count", "hls_s30_count", "landscan_count", "landcover_count", "activity_count"],
        ),
        ee.batch.Export.table.toDrive(
            collection=samples,
            description=f"{EXPORT_DESCRIPTION}_endpoint_samples",
            folder=DRIVE_FOLDER,
            fileNamePrefix=f"{FILE_PREFIX}_endpoint_samples",
            fileFormat="CSV",
            selectors=["year", "endpoint_label", *FEATURE_BANDS],
        ),
    ]
    for year in EXPECTED_YEARS:
        feature_stack = _annual_feature_stack(year, aoi).select(FEATURE_BANDS)
        probability = feature_stack.classify(classifier).rename("urban_probability")
        uncertainty = probability.multiply(ee.Image(1).subtract(probability)).multiply(4).rename("model_uncertainty")
        derived = probability.addBands(uncertainty).addBands(feature_stack.select("valid_observation_count"))
        tasks.append(
            ee.batch.Export.image.toDrive(
                image=derived,
                description=f"{EXPORT_DESCRIPTION}_{year}_probability",
                folder=DRIVE_FOLDER,
                fileNamePrefix=f"{FILE_PREFIX}_{year}_probability",
                region=aoi,
                crs=CRS,
                crsTransform=CRS_TRANSFORM,
                maxPixels=MAX_PIXELS,
                fileFormat="GeoTIFF",
            )
        )
    return tasks


def main() -> int:
    tasks = build_export_tasks()
    for task in tasks:
        task.start()
        print({"task_id": task.id, "state": "SUBMITTED"})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

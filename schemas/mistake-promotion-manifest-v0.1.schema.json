{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fwrog/gee-agent-skill/schemas/mistake-promotion-manifest-v0.1.schema.json",
  "title": "Mistake Promotion Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "item_count",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "mistake-promotion-manifest/v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "failure_class",
        "source_tier",
        "public_boundary",
        "public_summary",
        "missed_checks",
        "distill_targets",
        "regression_ids",
        "ignorance_boundary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/portableId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failure_class": {
          "$ref": "#/$defs/portableId"
        },
        "source_tier": {
          "enum": [
            "official",
            "paper",
            "reviewed_community",
            "candidate",
            "internal"
          ]
        },
        "public_boundary": {
          "enum": [
            "pattern_only",
            "public"
          ]
        },
        "public_summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "missed_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "distill_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(dataset|evidence|eval|failure|operator|rule|skill|workflow):[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "regression_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/portableId"
          }
        },
        "ignorance_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omitted_or_unverified",
            "project_alias_excluded",
            "raw_evidence_refs_excluded",
            "note_body_excluded"
          ],
          "properties": {
            "omitted_or_unverified": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "project_alias_excluded": {
              "const": true
            },
            "raw_evidence_refs_excluded": {
              "const": true
            },
            "note_body_excluded": {
              "const": true
            }
          }
        }
      }
    }
  }
}
